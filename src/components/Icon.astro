// Inline SVG icons — no icon font, no runtime JS.
// Brand marks (instagram, flickr, 500px, linkedin, github) are Simple Icons paths (CC0).
interface Props {
  name: 'instagram' | 'flickr' | '500px' | 'linkedin' | 'github' | 'mail';
  size?: number;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;

// The 500px mark is a wordmark that only fills a 24×8 band of its 24×24 box, so it is
// cropped to that band and drawn wider than the square icons to stay legible.
