---

<svg
  class={className}
  width={wide ? size * 1.8 : size}
  height={wide ? size * 0.6 : size}
  viewBox={wide ? '0 8 24 8' : '0 0 24 24'}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
