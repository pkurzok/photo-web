---
import { Image } from 'astro:assets';
import image from '../assets/masthead.jpg';

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="masthead">
  <Image
    src={image}
    alt=""
    format="webp"
    quality={82}
    width={image.width}
    widths={[640, 1024, image.width]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <p>{text}</p>
</div>

<style>
  .masthead {
    position: relative;
    display: grid;
    place-items: center;
    height: 30vh;
    min-height: 11rem;
    padding-inline: var(--gutter);
    overflow: hidden;
    background: #1b2733;
    color: #fff;
  }

  .masthead img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .masthead p {
    position: relative;
    margin: 0;
    font-size: clamp(0.9375rem, 2.2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.35);
  }
</style>
