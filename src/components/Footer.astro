---
import Icon from './Icon.astro';
import site from '../data/site.json';

type IconName = Parameters<typeof Icon>[0]['name'];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <div class="meta">
      <p class="copy">© {year} {site.name}</p>
      <nav class="links" aria-label="Legal">
        <a href="/imprint">Imprint</a>
        <a href="/privacy">Privacy</a>
        <a href={site.appsUrl} rel="me">Apps</a>
      </nav>
    </div>
    <ul class="social" aria-label="Elsewhere">
      {
        site.channels.map((c) => (
          <li>
            <a href={c.href} rel={c.id === 'mail' ? undefined : 'me noopener'}>
              <Icon name={c.id as IconName} size={20} />
              <span class="sr-only">{c.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    margin-top: clamp(3rem, 8vw, 5rem);
    padding-block: 1.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .inner,
  .meta,
  .links,
  .social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .inner {
    gap: 1rem 2rem;
    justify-content: space-between;
  }

  .meta {
    gap: 0.5rem 1.5rem;
  }

  .copy {
    margin: 0;
  }

  .links {
    gap: 1.25rem;
  }

  .links a {
    color: inherit;
    text-decoration: none;
  }

  .social {
    list-style: none;
    margin: 0 -0.5rem;
    padding: 0;
  }

  .social a {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding-inline: 0.5rem;
    color: inherit;
  }

  .links a:hover,
  .links a:focus-visible,
  .social a:hover,
  .social a:focus-visible {
    color: var(--text);
  }

  .links a:hover,
  .links a:focus-visible {
    text-decoration: underline;
  }
</style>
